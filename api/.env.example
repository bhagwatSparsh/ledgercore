NODE_ENV=development
PORT=4000

# App connects as the dedicated low-privilege role (see db/migrations/011_rls_policies.sql),
# never as the postgres superuser -- that's what makes Row-Level Security actually matter.
DATABASE_URL=postgresql://ledgercore_app:change_me_in_prod@localhost:5432/ledgercore

JWT_SECRET=replace_with_a_long_random_string_in_prod
JWT_EXPIRES_IN=24h

REDIS_URL=redis://localhost:6379

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
