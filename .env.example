# Root-level overrides for docker-compose.yml. Copy to .env (same
# directory as docker-compose.yml) before `docker compose up --build`
# if you want anything other than the defaults baked into the compose
# file -- both already have sane development defaults and this file is
# optional for just trying the project out.

JWT_SECRET=replace_with_a_long_random_string_in_prod

# Must be reachable from your BROWSER, not from inside Docker's network
# -- leave as-is unless you're exposing the api container on a
# different host/port.
VITE_API_BASE_URL=http://localhost:4000
