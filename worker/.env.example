DATABASE_URL=postgresql://ledgercore_app:change_me_in_prod@localhost:5432/ledgercore

# How many outbox events to dispatch per polling cycle.
OUTBOX_BATCH_SIZE=100

# In a real deployment, dispatched events would POST to this webhook URL
# (or publish to a queue). Left unset here, the worker just logs them --
# simulating the integration point without requiring an external service
# for the project to run end to end.
NOTIFICATION_WEBHOOK_URL=
